# Copy to android/keystore.properties (gitignored) or export RELEASE_* env vars.
# Generate the upload/sideload keystore OFF this repository. Never commit
# the keystore, this filled-in file, or the passwords.
#
#   keytool -genkeypair -v \
#     -keystore "$HOME/keys/somersett-fire-radio-scanner-release.keystore" \
#     -alias somersett \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -storetype PKCS12
#
# Paths may be absolute or relative to the android/ Gradle root.
storeFile=/absolute/path/to/somersett-fire-radio-scanner-release.keystore
storePassword=
keyAlias=somersett
keyPassword=
